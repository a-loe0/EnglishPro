{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "englishgopro-tutor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Only /api/tutor is intercepted; every other /api path still reaches the
  // origin backend through the existing proxied DNS record.
  "routes": [
    { "pattern": "englishgopro.com/api/tutor*", "zone_name": "englishgopro.com" }
  ],
  "workers_dev": false,

  "ai": { "binding": "AI" },

  // Per-student burst guard. Period must be 10 or 60 seconds.
  "ratelimits": [
    {
      "name": "TUTOR_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ],

  "vars": {
    "TUTOR_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  // Secret (set with `npx wrangler secret put JWT_SECRET`): must equal the
  // backend's JWT_SECRET so the Worker accepts the site's access tokens.

  "observability": { "enabled": true }
}
