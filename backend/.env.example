# Local development template. Copy to .env and adjust.
# Production values live in .env.production on the deploy host (gitignored) —
# see cloud-setup-implementation.md Phase 4.

# Database
DATABASE_URL="postgresql://localhost:5432/englishgopro_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (generate your own!)
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=8000
NODE_ENV="development"
# Must match the Vite dev server origin — this drives CORS in src/index.ts.
FRONTEND_URL="http://localhost:5173"

# Storage Paths
# NOTE: write these out in full. dotenv does NOT expand ${VAR} references, so
# "${STORAGE_PATH}/videos" would be taken literally and create a directory
# named "${STORAGE_PATH}".
STORAGE_PATH="/Users/YOUR_USERNAME/englishgopro-storage"
VIDEOS_PATH="/Users/YOUR_USERNAME/englishgopro-storage/videos"
THUMBNAILS_PATH="/Users/YOUR_USERNAME/englishgopro-storage/thumbnails"
SUBMISSIONS_PATH="/Users/YOUR_USERNAME/englishgopro-storage/submissions"
AVATARS_PATH="/Users/YOUR_USERNAME/englishgopro-storage/avatars"
TEMP_PATH="/Users/YOUR_USERNAME/englishgopro-storage/temp"

# FFmpeg
# Local (Homebrew) path. The production container installs ffmpeg from Alpine
# and sets FFMPEG_PATH=/usr/bin/ffmpeg in its own ENV, so this value is only
# ever used for local development.
FFMPEG_PATH="/opt/homebrew/bin/ffmpeg"

# Upload Limits
# Matches production. Uploads are buffered entirely in memory by multer
# (src/middleware/upload.ts), so this is a memory ceiling, not just a policy.
MAX_VIDEO_SIZE_MB=95
MAX_SUBMISSION_SIZE_MB=95

# Transcode workers. Defaults to 1 in code — ffmpeg saturates every core it is
# given. Uncomment only to tune; a restart applies it.
# QUEUE_CONCURRENCY=1

# Email (optional). With SMTP_USER unset, password-reset links are printed to
# the server log instead of being emailed — fine for local dev, but it means
# self-service password reset does not work until these are configured.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
FROM_EMAIL="noreply@englishgopro.com"
FROM_NAME="EnglishGoPro"
