# Keep the build context small and — more importantly — keep secrets out of the
# image. The Dockerfile copies selectively, but this is defence in depth.

node_modules
dist

# Secrets. .env.production holds live JWT and database credentials.
.env
.env.*
!.env.example

# Local dev database artifacts (also gitignored)
prisma/*.db
prisma/*.db-journal

tests
coverage
*.log
*.md
.git
.gitignore
Dockerfile
.dockerignore
